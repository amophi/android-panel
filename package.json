{
  "name": "android-panel",
  "displayName": "Android Panel",
  "description": "%extension.description%",
  "icon": "icon.png",
  "version": "0.2.2",
  "publisher": "amophi",
  "license": "MIT",
  "homepage": "https://github.com/amophi/android-panel#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/amophi/android-panel.git"
  },
  "bugs": {
    "url": "https://github.com/amophi/android-panel/issues"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other",
    "Testing"
  ],
  "keywords": [
    "android",
    "scrcpy",
    "adb",
    "mirror",
    "device"
  ],
  "galleryBanner": {
    "color": "#1f1f1f",
    "theme": "dark"
  },
  "scripts": {
    "test": "node test/smoke.js",
    "package": "npx --yes @vscode/vsce package --no-dependencies --out android-panel.vsix"
  },
  "main": "./extension.js",
  "l10n": "./l10n",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%capabilities.untrustedWorkspaces%"
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "%capabilities.virtualWorkspaces%"
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "androidPanel",
          "title": "Android Panel",
          "icon": "icon.svg"
        }
      ]
    },
    "views": {
      "androidPanel": [
        {
          "id": "androidPanel.screen",
          "name": "%view.screen.name%",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "androidPanel.launch",
        "category": "Android Panel",
        "title": "%command.launch.title%"
      },
      {
        "command": "androidPanel.reconnect",
        "category": "Android Panel",
        "title": "%command.reconnect.title%"
      }
    ],
    "configuration": {
      "title": "Android Panel",
      "properties": {
        "androidPanel.show": {
          "type": "string",
          "enum": [
            "phone",
            "app"
          ],
          "default": "phone",
          "markdownDescription": "%config.show%",
          "markdownEnumDescriptions": [
            "%config.show.phone%",
            "%config.show.app%"
          ]
        },
        "androidPanel.adbPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.adbPath%"
        },
        "androidPanel.package": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.package%"
        },
        "androidPanel.intervalMs": {
          "type": "number",
          "default": 600,
          "minimum": 150,
          "markdownDescription": "%config.intervalMs%"
        },
        "androidPanel.serial": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.serial%"
        },
        "androidPanel.mode": {
          "type": "string",
          "enum": [
            "stream",
            "screencap"
          ],
          "default": "stream",
          "markdownDescription": "%config.mode%",
          "markdownEnumDescriptions": [
            "%config.mode.stream%",
            "%config.mode.screencap%"
          ]
        },
        "androidPanel.scrcpyServerPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.scrcpyServerPath%"
        },
        "androidPanel.scrcpyVersion": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.scrcpyVersion%"
        },
        "androidPanel.newDisplay": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.newDisplay%"
        },
        "androidPanel.maxFps": {
          "type": "number",
          "default": 0,
          "markdownDescription": "%config.maxFps%"
        },
        "androidPanel.keepStreamWhenHidden": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.keepStreamWhenHidden%"
        },
        "androidPanel.maxSize": {
          "type": "number",
          "default": 1080,
          "markdownDescription": "%config.maxSize%"
        },
        "androidPanel.wakeDevice": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.wakeDevice%"
        },
        "androidPanel.stayAwake": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.stayAwake%"
        }
      }
    }
  }
}
